# ═══════════════════════════════════════════════════════════════════════════════
# KTM Bus Tracker — Environment Configuration Template
# 
# Copy this to .env and fill in YOUR values
# .env is gitignored (secrets stay local)
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Redis — In-memory data store for bus locations + sessions
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your_strong_redis_password_here_min_16_chars

# ─────────────────────────────────────────────────────────────────────────────
# JWT — Authentication tokens
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_256bit_secret_key_here_min_32_chars_recommended_use_openssl_rand
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — Trip history + route definitions
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here_min_16_chars

# ─────────────────────────────────────────────────────────────────────────────
# Public URL & CORS — Cloudflared tunnel or custom domain
# ─────────────────────────────────────────────────────────────────────────────
# For free Cloudflare tunnel (changes every restart):
#   PUBLIC_URL=https://your-random-id.trycloudflare.com
# For named tunnel (persistent):
#   PUBLIC_URL=https://bustrack.yourdomain.com
PUBLIC_URL=https://your-tunnel-url-here.trycloudflare.com

# CORS_ORIGINS: Comma-separated list of allowed origins for web admin panel
# Native apps don't need CORS but web panel does
CORS_ORIGINS=https://your-tunnel-url-here.trycloudflare.com,http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OTP Gateway — Telegram (mock) or real SMS (Aakash/Sparrow)
# ─────────────────────────────────────────────────────────────────────────────
OTP_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_NAME=KTMBusTrackerBot
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Alternative SMS providers (Nepal):
#   Aakash SMS: https://www.aakashsms.com/
#   Sparrow SMS: https://sparrowsms.com.np/
# AAKASH_API_KEY=your_aakash_key
# SPARROW_TOKEN=your_sparrow_token

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging — Geofence alerts (optional)
# ─────────────────────────────────────────────────────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key_here_if_using_notifications

# ─────────────────────────────────────────────────────────────────────────────
# Deployment Environment
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────────
# Strava OAuth Integration
# ─────────────────────────────────────────────────────────────────────────────
# Register your app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_WEBHOOK_VERIFY_TOKEN=kabja_strava_verify
# Callback URL — must match EXACTLY your Strav app redirect URI:
STRAVA_REDIRECT_URI=https://yourdomain.com/api/strava/callback
# Flutter app deep link — app handles the redirect after OAuth:
STRAVA_APP_REDIRECT=kabja://strava-callback

# ═══════════════════════════════════════════════════════════════════════════════
# HOW TO USE THIS FILE:
# 
# 1. Copy to .env:
#    cp .env.example .env
#
# 2. Fill in YOUR values (see descriptions above)
#
# 3. Load with docker compose:
#    docker compose up -d
#
# The app reads these variables from .env automatically
# ═══════════════════════════════════════════════════════════════════════════════
